// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthType {
  GOOGLE
  EMAIL
}

model Email {
  id          Int       @id @default(autoincrement())
  email       String    @unique
  authType    AuthType
  userId      Int
  priority    Int?
  activatedAt DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("emails")
}

model User {
  id            Int       @id @default(autoincrement())
  uid           String    @unique
  passwd        String?
  name          String?
  email         String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  emailVerified DateTime?

  accounts      Account[]
  sessions      Session[]
  emails        Email[]
  groupUsers    GroupUser[]
  activityUsers ActivityUser[]

  @@map("users")
}

model Group {
  id            Int      @id @default(autoincrement())
  parentGroupId Int?     @map("parent_group_id")
  name          String
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  parent   Group?  @relation("GroupHierarchy", fields: [parentGroupId], references: [id])
  children Group[] @relation("GroupHierarchy")

  groupUsers     GroupUser[]
  activityGroups ActivityGroup[]

  @@map("groups")
}

model GroupUser {
  id       Int      @id @default(autoincrement())
  userId   Int
  groupId  Int
  role     Int
  joinedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@map("group_users")
}

model Place {
  id        Int      @id @default(autoincrement())
  name      String
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities        Activity[]
  activityTemplates ActivityTemplate[]

  @@map("places")
}

model ActivityTemplate {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  whenType    Int
  when        String
  placeId     Int?

  place Place? @relation(fields: [placeId], references: [id])

  @@map("activity_templates")
}

model Activity {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  startedAt   DateTime
  finishedAt  DateTime?
  placeId     Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  place  Place?          @relation(fields: [placeId], references: [id])
  groups ActivityGroup[]
  users  ActivityUser[]

  @@map("activities")
}

model ActivityGroup {
  id         Int @id @default(autoincrement())
  activityId Int
  groupId    Int

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([activityId, groupId])
  @@map("activity_groups")
}

model ActivityUser {
  id         Int      @id @default(autoincrement())
  activityId Int
  userId     Int
  status     Int
  joinedAt   DateTime @default(now())
  updatedAt  DateTime @updatedAt

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId])
  @@map("activity_users")
}

// NextAuth.js models
model Account {
  id                String  @id @default(cuid())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}
