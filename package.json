{
  "name": "group-member-list",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "dev:mail": "maildev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "npm run db:seed && start-server-and-test dev http://localhost:3000 test:ci",
    "test:ci": "jest --runInBand",
    "test:local": "bash bin/test-local.sh",
    "start:test": "sh -c 'export $(grep -v \"^#\" .env.test | xargs) && PORT=3001 next start'",
    "prisma": "prisma",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "ci:test": "npx prisma db push && npm run prisma:generate && npm run build && start-server-and-test start http://localhost:3000 'jest --runInBand'",
    "prisma:studio": "prisma studio",
    "reset": "prisma migrate reset --force --skip-seed",
    "rest": "npm run reset && npm run prisma:generate && npm run build",
    "db:seed": "npx tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "leaflet": "^1.9.4",
    "next": "^15.5.12",
    "nodemailer": "^7.0.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@prisma/client": "6.15.0",
    "@prisma/internals": "6.15.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^29.5.14",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.9",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "8.57.0",
    "eslint-config-next": "15.1.6",
    "jest": "^29.7.0",
    "maildev": "^2.2.1",
    "prettier": "^3.2.5",
    "prisma": "6.15.0",
    "smtp-server": "^3.18.1",
    "start-server-and-test": "^2.1.5",
    "supertest": "^7.2.2",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.9",
    "tsx": "^4.7.0",
    "typescript": "^5",
    "wait-on": "^7.0.1"
  }
}
